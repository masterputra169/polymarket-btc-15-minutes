# Docker Compose settings. Copy to .env if you want to override defaults.

TZ=Asia/Jakarta

# Host interface for the published frontend port. Defaults to loopback so the
# dashboard is only reachable from this machine. Set FRONTEND_BIND=0.0.0.0 as
# an explicit opt-in to expose it on the LAN.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3010

# REQUIRED. PostgreSQL password for the compose stack. Generate with:
#   openssl rand -hex 24
# Never commit the real value.
POSTGRES_PASSWORD=

# REQUIRED. Auth token for the bot status WebSocket (:3099). The bot refuses
# unauthenticated clients on a non-loopback bind; the frontend build embeds
# this token so the dashboard can connect. Generate with:
#   openssl rand -hex 32
STATUS_AUTH_TOKEN=

# REQUIRED. Auth token for the read-only report API (:3101). Generate with:
#   openssl rand -hex 32
REPORT_AUTH_TOKEN=

RUNTIME_INTEGRATIONS_ENABLED=true
POSTGRES_BACKUP_RETENTION_DAYS=14
POSTGRES_BACKUP_INTERVAL_SEC=86400

# Keeps Polymarket market discovery working on networks where normal DNS is
# redirected/blocked. Set to false only when system DNS resolves Polymarket
# domains correctly.
POLYMARKET_DOH_ENABLED=true
POLYMARKET_DOH_URL=https://cloudflare-dns.com/dns-query

# ML retrain quality gates. These block auto-deploy when a new model looks
# weak, miscalibrated, or likely overfit.
RETRAIN_MIN_ACCURACY=0.70
RETRAIN_MIN_AUC=0.80
RETRAIN_MIN_HIGH_CONF_ACCURACY=0.78
RETRAIN_MIN_HIGH_CONF_COVERAGE=5
RETRAIN_MAX_HIGH_CONF_COVERAGE=98
RETRAIN_MAX_CALIBRATION_ECE=0.08
RETRAIN_MAX_CV_TEST_ACC_GAP=0.04
RETRAIN_MAX_TEST_HOLDOUT_ACC_GAP=0.08
RETRAIN_REQUIRE_STRICT_HOLDOUT=true
