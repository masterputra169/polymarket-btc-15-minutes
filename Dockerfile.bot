FROM node:25-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY bot/package.json bot/package-lock.json ./bot/
RUN cd bot && npm ci --omit=dev

COPY src ./src
COPY bot ./bot
COPY public/ml ./public/ml
COPY tsconfig*.json ./

RUN mkdir -p /app/bot/data && chown -R node:node /app

USER node
EXPOSE 3099

CMD ["node", "bot/index.ts"]
