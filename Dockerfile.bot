FROM node:25-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY bot/package.json bot/package-lock.json ./bot/
RUN cd bot && npm ci --omit=dev

COPY src ./src
COPY bot ./bot
COPY public/ml ./public/ml
COPY tsconfig*.json ./

# Only the two directories the bot writes to need to belong to `node`; both are
# bind-mounted at runtime anyway, so this is really just for a mount-less run.
# The previous `chown -R node:node /app` walked both node_modules trees, which
# made this the slowest layer in the build and killed it twice on a 20GB host
# for want of memory. Everything else is read-only at runtime and world-readable
# as COPY leaves it.
RUN mkdir -p /app/bot/data && chown node:node /app/bot/data /app/public/ml

USER node
EXPOSE 3099

CMD ["node", "bot/index.ts"]
