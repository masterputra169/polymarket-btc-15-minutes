FROM node:25-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tsconfig*.json ./
COPY src ./src
COPY public ./public

ARG VITE_BOT_WS_URL=/ws
ENV VITE_BOT_WS_URL=${VITE_BOT_WS_URL}

# Status WS auth token, embedded in the built JS bundle (see docs/DOCKER_STACK.md).
# On Railway this ARG is filled from the frontend service's variable of the same name.
ARG VITE_BOT_STATUS_TOKEN=
ENV VITE_BOT_STATUS_TOKEN=${VITE_BOT_STATUS_TOKEN}

RUN npm run build

FROM nginx:1.27-alpine

# The image's entrypoint renders /etc/nginx/templates/*.template with envsubst,
# substituting only the names matched by NGINX_ENVSUBST_FILTER so nginx's own
# $variables survive. BOT_HOST defaults to the compose service name; Railway
# overrides it with bot.railway.internal. NGINX_ENTRYPOINT_LOCAL_RESOLVERS makes
# the image's own 15-local-resolvers.envsh export NGINX_LOCAL_RESOLVERS from
# /etc/resolv.conf (a custom .envsh would need the exec bit, which an upload
# from Windows does not carry — that crashed the first Railway deploy).
ENV NGINX_ENVSUBST_FILTER='^(BOT_HOST|NGINX_LOCAL_RESOLVERS)$' \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=true \
    BOT_HOST=bot
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
