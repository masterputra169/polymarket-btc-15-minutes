FROM node:25-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tsconfig*.json ./
COPY src ./src
COPY public ./public

ARG VITE_BOT_WS_URL=/ws
ENV VITE_BOT_WS_URL=${VITE_BOT_WS_URL}

# Status WS auth token, embedded in the built JS bundle (see docs/DOCKER_STACK.md).
ARG VITE_BOT_STATUS_TOKEN=
ENV VITE_BOT_STATUS_TOKEN=${VITE_BOT_STATUS_TOKEN}

RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
