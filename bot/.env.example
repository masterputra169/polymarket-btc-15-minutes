# Polymarket CLOB API credentials (CLOB V2 — docs/CLOB_V2_MIGRATION.md).
# L1/L2 auth is unchanged in V2: keys derived before the cutover keep working.
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Wallet that holds the pUSD (Polymarket proxy / Safe). Unset = the EOA trades for itself.
POLYMARKET_PROXY_ADDRESS=
# Optional signature type override: 0 EOA, 1 POLY_PROXY, 2 POLY_GNOSIS_SAFE
# (the default when a proxy is set), 3 Deposit Wallet (POLY_1271).
# POLYMARKET_SIGNATURE_TYPE=
# Optional Polygon RPC for the live-startup readiness check (view calls only).
# Default: the first of CONFIG.chainlink.polygonRpcUrls.
# POLYGON_RPC_URL=

# Trading parameters
BANKROLL=100
MAX_DAILY_LOSS_PCT=20
MAX_CONSECUTIVE_LOSSES=5

# Safety
DRY_RUN=true

# Logging
LOG_LEVEL=info

# Poll interval (ms)
POLL_INTERVAL_MS=5000

# Chainlink Data Streams (Option A — exact PTB match with Polymarket resolution source)
# Apply for sponsored API key via Chainlink Labs / Polymarket 15m markets program.
# Without these vars, adapter is dormant and PTB falls back to polymarket_page / chainlink_round.
# CHAINLINK_DS_API_KEY=
# CHAINLINK_DS_USER_SECRET=
# CHAINLINK_DS_BTC_FEED_ID=0x000359843a543ee2fe414dc14c7e7920ef10f4372990b79d6361cdc0dd1ba782
# CHAINLINK_DS_TESTNET=false

# ─── Macro Event Guard ──────────────────────────────────────────────
# Block trading around high-impact macro events (CPI, FOMC, NFP).
# Source: ForexFactory weekly calendar — free, no key needed.
# Ultra-ML (≥95%) overrides the block. Manual events in bot/data/macro_events_manual.json.
MACRO_GUARD_ENABLED=true
MACRO_PRE_MIN=30                    # minutes before event to start blocking
MACRO_POST_MIN=15                   # minutes after event to keep blocking
MACRO_FETCH_INTERVAL_MS=21600000    # 6h — weekly FF calendar, re-fetch periodically
MACRO_IMPACT_LEVELS=High            # comma-separated: High,Medium,Low
MACRO_CURRENCIES=USD                # comma-separated: USD,EUR,GBP

# ─── LLM Regime Classifier (P2 advisory) ────────────────────────────
# Slow-loop (~5min) regime classification via OpenRouter LLM. Shadow mode = log only.
# Requires AI_AGENT_ENABLED=true + OPENROUTER_API_KEY=sk-or-xxx.
# Cost: ~$0.001/call with Gemini Flash × 12/hr = ~$0.30/day.
# Flip LLM_REGIME_SHADOW=false AFTER 2-4 weeks of shadow A/B data confirm alpha.
LLM_REGIME_ENABLED=false
LLM_REGIME_SHADOW=true              # true = log only, false = actively block on conflict
LLM_REGIME_INTERVAL_MS=300000       # 5 min
LLM_REGIME_MAX_TOKENS=500
LLM_REGIME_MIN_CONF=0.70            # ignore classifications below this confidence
LLM_REGIME_ML_BYPASS=0.90           # ML ≥ this overrides LLM block

# ─── Session gate ───────────────────────────────────────────────────
# Sessions the bot will not trade at all. Comma-separated, case-insensitive,
# matched against getSessionName(): Asia | Europe | EU/US Overlap | US | Off-hours.
# Hard gate — no high-edge, oracle-lag or ML-confidence bypass can unblock it.
# Read once at module load in tradeFilters.ts, so a change needs a restart.
# Europe blocked 2026-09-20: 123 Railway dry-run trades, 55.6% WR week 1 and
# 58.3% week 2 — under its ~64% breakeven in both weeks — for -17.05.
# NOTE: gates applyTradeFilters() only. preMarketLong.ts does not go through it,
# so blocking 'EU/US Overlap' would not stop the 09:00-09:15 ET premarket long
# (which sits in that window) — use PREMARKET_LONG_ENABLED for that.
# Emptied 2026-09-25 (operator decision): every session trades.
BLOCKED_SESSIONS=

# Time-of-day / day-of-week gates: ET blackout hours 16-23, the weekend ML
# floor and the two Asia-session ML floors. Off by default since 2026-09-25 —
# their evidence was v1-era, and with the calibrated v2 model the Asia floor
# (ML conf >= 0.80, i.e. p >= 0.90) had become a de-facto block. true restores
# all four. SESSION_QUALITY still scales bet size by session; that blocks nothing.
TIME_GATES_ENABLED=false

# ─── Pre-market long (09:00-09:15 EST) ──────────────────────────────
# Buys UP unconditionally, without consulting any signal, at PREMARKET_LONG_RISK_PCT
# of bankroll (8x a normal trade at 0.10). Disabled 2026-09-20: 10 dry-run trades,
# 30% WR, -19.88 — it consumed nearly the whole book's profit.
PREMARKET_LONG_ENABLED=false
PREMARKET_LONG_RISK_PCT=0.10

# ─── RL bandit bet sizing: REMOVED 2026-09-25 ───────────────────────
# The contextual bandit never worked (saturated softmax, constant action,
# reward loop never closed) and was disabled 2026-09-20; its code, weights
# and trainer are gone. RL_* variables are no longer read.

# ─── Entry filter thresholds (bot/src/safety/filterThresholds.ts) ───
# Every number the entry filters compare against can be overridden as
# FILTER_<NAME> (48 of them; the table in filterThresholds.ts lists each with
# its default and bounds). Unset = the default the code had hard-coded. A value
# that is not a number or is out of bounds is REFUSED at startup with a
# warning, never silently defaulted. Changing one changes which trades the bot
# takes — during an evaluation window that restarts the window.
# FILTER_ML_CONF_MIN=0.65
# FILTER_BASE_HARD_CAP=0.68

# ─── Evaluation-window report (bot/src/monitoring/evaluationReport.ts) ─
# Daily Telegram message: realistic-fill win rate vs breakeven with a Wilson
# 95% interval, by session, since EVAL_WINDOW_START (the deploy time of the
# strategy being evaluated). Unset = off. Record-only.
# EVAL_WINDOW_START=2026-09-25T16:53:38Z
# EVAL_TARGET_TRADES=150
# EVAL_REPORT_HOUR_UTC=0

# ─── Dry-run fill realism ───────────────────────────────────────────
# No env knob on purpose. Since 2026-09-20 DRY_RUN charges the fill at
# fokBuyPrice(quote, spread) — the exact limit the live path submits — and
# rejects orders larger than the resting askLiquidity, like a real FOK.
# The journal keeps both prices (expectedPrice = quote, actualPrice = fill)
# plus entry.fillModel, so the old optimistic number stays reconstructable
# from the data without a flag that could be flipped back by accident.

# ─── Telegram buttons ───────────────────────────────────────────────
# Every Telegram alert carries inline buttons: View Market (when the message
# has a market link), View Profile, then View Web -> this dashboard URL.
# Defaults to the Railway dashboard when unset. An unusable value drops only
# the View Web button (logged once), never the alert. The link never carries
# ?botStatusToken= — log in once per browser instead.
# DASHBOARD_URL=https://frontend-production-d0bf1.up.railway.app

# ─── Market tape (bot/src/tape) ─────────────────────────────────────
# 1 Hz record of the Polymarket book (top TAPE_DEPTH levels of both tokens),
# every trade print, BTC feeds and the PTB — second-resolution history for
# future training. Own CLOB socket; cannot affect trading. Hourly gzip files
# in bot/data/tape, uploaded to an S3-compatible bucket and then deleted
# locally. Without TAPE_S3_* they stay on disk under TAPE_MAX_LOCAL_MB, and
# writing stops below TAPE_MIN_FREE_MB free. See docs/RAILWAY.md.
# TAPE_ENABLED=true
# TAPE_INTERVAL_MS=1000
# TAPE_DEPTH=10
# TAPE_MAX_LOCAL_MB=1500
# TAPE_MIN_FREE_MB=500
# Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto.
# Backblaze B2: https://s3.<region>.backblazeb2.com with TAPE_S3_REGION=<region>.
# TAPE_S3_ENDPOINT=
# TAPE_S3_BUCKET=polybtc15-tape
# TAPE_S3_ACCESS_KEY_ID=
# TAPE_S3_SECRET_ACCESS_KEY=
# TAPE_S3_REGION=auto
# TAPE_S3_PREFIX=btc15/tape/
