    "@x402/svm": "^2.31.0",
    "aws4fetch": "^1.0.20",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "pg": "^8.22.0",
    "redis": "^6.0.1",
    "viem": "^2.53.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "axios": "^1.21.1",
    "follow-redirects": "^1.16.3",
