# Rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf
# (see Dockerfile.frontend). Only ${BOT_HOST} and ${RESOLVER} are substituted
# (NGINX_ENVSUBST_FILTER); every other $variable below is nginx's own.
#
#   BOT_HOST  - where the bot lives: `bot` on docker-compose,
#               `bot.railway.internal` on Railway private networking.
#   RESOLVER  - the DNS server nginx must ask at request time, read from
#               /etc/resolv.conf at container start (docker/nginx-resolver.envsh).
#               Needed because the bot's private IP changes on every redeploy;
#               a static proxy_pass would keep the stale address until nginx
#               itself restarted.

# Rate limit for the report API: 10 req/s per client IP, small burst absorbed.
limit_req_zone $binary_remote_addr zone=reports:1m rate=10r/s;

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  resolver ${RESOLVER} valid=10s ipv6=on;

  # --- Security headers (inherited by all locations below; a location-level
  # --- add_header would suppress inheritance, so keep add_header here only).
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # Content-Security-Policy fitted to this SPA:
  #   script-src 'self'          - Vite emits external JS chunks only
  #   style-src 'unsafe-inline'  - inline styles injected by the React bundle
  #   img-src data:              - inline data-URI icons
  #   connect-src ws: wss:       - same-origin /ws WebSocket and /api/reports
  #   frame-ancestors 'none'     - dashboard must never be framed
  # Adjust if you add external fonts/CDNs/analytics.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
  # No HSTS here: this server terminates plain HTTP. Railway / any TLS proxy in
  # front of the stack adds it.

  # Platform healthcheck. Static on purpose: it says "nginx is up", not
  # "the bot is up" - that is /api/health/report below.
  location = /health {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Upstreams are written with a variable in the URI so nginx resolves the
  # hostname per request through `resolver` instead of once at startup.
  location /ws {
    proxy_pass http://${BOT_HOST}:3099$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location ~ ^/api/reports(/.*)?$ {
    limit_req zone=reports burst=20 nodelay;
    proxy_pass http://${BOT_HOST}:3101/reports$1$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /api/health/report {
    proxy_pass http://${BOT_HOST}:3101/health$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }
}
