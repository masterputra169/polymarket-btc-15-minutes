{
  "name": "polymarket-btc-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:bot && npm run typecheck:bot:core && npm run typecheck:scripts",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "typecheck:bot": "tsc -p tsconfig.bot.json",
    "typecheck:bot:core": "tsc -p tsconfig.bot.core.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
