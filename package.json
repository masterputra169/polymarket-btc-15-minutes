{
  "name": "polymarket-btc-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ml": "python -m pytest backtest/ml_training/tests -q",
    "test:ml:cov": "python -m pytest backtest/ml_training/tests --cov=mltrain --cov-report=term-missing",
    "pg:backfill": "node bot/scripts/backfillPostgres.mts",
    "pg:report": "node bot/scripts/postgresReport.mts",
    "ml:audit": "node bot/scripts/mlQualityAudit.mts",
    "ml:retrain:dry": "node bot/src/autoRetrain.ts --force --dry-run",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:bot && npm run typecheck:bot:core && npm run typecheck:scripts",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "typecheck:bot": "tsc -p tsconfig.bot.json",
    "typecheck:bot:core": "tsc -p tsconfig.bot.core.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
