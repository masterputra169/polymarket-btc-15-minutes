[Unit]
Description=PolyBTC15 dashboard auth gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/polybtc15
EnvironmentFile=/opt/polybtc15/auth.env
ExecStart=/usr/local/bin/node /opt/polybtc15/scripts/dashboard-auth-server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
