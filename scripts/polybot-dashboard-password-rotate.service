[Unit]
Description=Rotate POLY//15 dashboard password and send it to Telegram
After=network-online.target polybot-dashboard-auth.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/node /opt/polybtc15/scripts/rotate-dashboard-password.mjs
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
